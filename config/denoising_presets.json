  "defaults": {
    "preset": "balanced",
    "method": "n2v"
  },
  "parameterRanges": {
    "patch_size": {
      "options": [32, 48, 64, 96, 128],
      "default": 32
    },
    "patches_per_image": {
      "min": 50,
      "max": 500,
      "step": 10,
      "default": 100
    },
    "batch_size": {
      "options": [1, 2, 4, 8, 16, 32],
      "default": 4
    },
    "mask_percentage": {
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 15
    },
    "use_augmentation": {
      "default": true
    },
    "features": {
      "options": [32, 48, 64, 96, 128],
      "default": 64
    },
    "num_layers": {
      "options": [2, 3, 4],
      "default": 2
    },
    "learning_rate": {
      "options": [0.00001, 0.00005, 0.0001, 0.0002],
      "labels": ["1e-5", "5e-5", "1e-4", "2e-4"],
      "default": 0.0001
    },
    "epochs": {
      "min": 10,
      "max": 500,
      "step": 10,
      "default": 100
    },
    "early_stopping_patience": {
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 10
    },
    "use_roi": {
      "default": true
    },
    "roi_threshold": {
      "min": 0.3,
      "max": 0.7,
      "step": 0.1,
      "default": 0.5
    },
    "use_resize_conv": {
      "default": true
    },
    "upsampling_mode": {
      "options": ["bilinear", "nearest", "bicubic"],
      "default": "bilinear"
    },
    "masking_strategy": {
      "options": [
        {"value": 0, "label": "Local Mean"},
        {"value": 1, "label": "Zeros"},
        {"value": 2, "label": "Random"}
      ],
      "default": 0
    },
    "base_percentile": {
      "min": 30,
      "max": 70,
      "step": 5,
      "default": 50
    },
    "percentile_decay": {
      "min": 1.0,
      "max": 1.3,
      "step": 0.05,
      "default": 1.15
    },
    "max_masked_pixels": {
      "min": 10,
      "max": 40,
      "step": 5,
      "default": 25
    }
  }
