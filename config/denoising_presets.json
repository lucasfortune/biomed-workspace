{
  "presets": {
    "fast": {
      "name": "Fast",
      "description": "Quick training for testing and previewing results. Lower quality but faster iteration.",
      "stage1": {
        "patch_size": 64,
        "patches_per_image": 100,
        "batch_size": 16,
        "mask_percentage": 15,
        "features": 32,
        "num_layers": 3,
        "learning_rate": 0.001,
        "epochs": 50,
        "early_stopping": true,
        "early_stopping_patience": 10
      },
      "stage2": {
        "patch_size": 64,
        "patches_per_image": 100,
        "batch_size": 16,
        "mask_percentage": 10,
        "features": 32,
        "num_layers": 3,
        "learning_rate": 0.001,
        "epochs": 50,
        "early_stopping": true,
        "early_stopping_patience": 10
