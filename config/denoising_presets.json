        "patches_per_image": 50,
        "batch_size": 16,
        "mask_percentage": 15,
        "use_augmentation": true,
        "features": 48,
        "num_layers": 2,
        "learning_rate": 0.0002,
        "epochs": 50,
        "early_stopping": true,
        "early_stopping_patience": 10,
        "use_roi": true,
        "roi_threshold": 0.5,
        "use_resize_conv": true,
        "upsampling_mode": "bilinear",
        "masking_strategy": 0
      },
      "stage2": {
        "patch_size": 48,
