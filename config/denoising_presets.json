      "stage2": {
        "patch_size": 96,
        "patches_per_image": 300,
        "batch_size": 4,
        "mask_percentage": 10,
        "features": 96,
        "num_layers": 4,
        "learning_rate": 0.0003,
        "epochs": 200,
        "early_stopping": true,
        "early_stopping_patience": 25
