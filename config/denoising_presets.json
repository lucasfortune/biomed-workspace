        "patch_size": 64,
        "patches_per_image": 200,
        "batch_size": 8,
        "mask_percentage": 10,
        "features": 64,
        "num_layers": 4,
        "learning_rate": 0.0005,
        "epochs": 100,
        "early_stopping": true,
        "early_stopping_patience": 15
      },
      "maskExtractor": {
        "adaptive_thresholding": true,
        "base_percentile": 50,
        "percentile_decay": 1.15,
        "max_masked_pixels": 30
      }
    },
    "high_quality": {
      "name": "High Quality",
