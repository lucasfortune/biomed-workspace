  "defaults": {
    "preset": "balanced",
    "method": "n2v"
  },
  "parameterRanges": {
    "patch_size": {
      "options": [32, 48, 64, 96, 128],
      "default": 64
    },
    "patches_per_image": {
      "min": 50,
      "max": 500,
      "step": 10,
      "default": 200
    },
    "batch_size": {
      "options": [1, 2, 4, 8, 16, 32],
      "default": 8
    },
    "mask_percentage": {
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 15
    },
    "features": {
      "options": [32, 48, 64, 96, 128],
      "default": 64
    },
    "num_layers": {
      "options": [2, 3, 4, 5],
      "default": 4
    },
    "learning_rate": {
      "min": 0.000001,
      "max": 0.001,
      "default": 0.0005
    },
    "epochs": {
      "min": 10,
      "max": 500,
      "step": 10,
      "default": 100
    },
    "early_stopping_patience": {
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 15
    },
    "base_percentile": {
      "min": 30,
      "max": 70,
      "step": 5,
      "default": 50
    },
    "percentile_decay": {
      "min": 1.0,
      "max": 1.3,
      "step": 0.05,
      "default": 1.15
    },
    "max_masked_pixels": {
      "min": 10,
      "max": 40,
      "step": 5,
      "default": 30
    }
  }
