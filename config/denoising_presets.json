  "defaults": {
    "preset": "balanced",
    "method": "n2v"
  },
  "parameterRanges": {
    "patch_size": {
      "options": [
        32,
        48,
        64,
        96,
        128,
        256
      ],
      "default": 64
    },
    "patches_per_image": {
      "min": 50,
      "max": 500,
      "step": 10,
      "default": 100
    },
    "batch_size": {
      "options": [
        1,
        2,
        4,
        8,
        16,
        24,
        32,
        64,
        128
      ],
      "default": 128
    },
    "mask_percentage": {
      "min": 0.5,
      "max": 30,
      "step": 0.5,
      "default": 1.5
    },
    "use_augmentation": {
      "default": true
    },
    "features": {
      "options": [
        32,
        48,
        64,
        96,
        128
      ],
      "default": 32
    },
    "num_layers": {
      "options": [
        2,
        3,
        4
      ],
      "default": 2
    },
    "learning_rate": {
      "options": [
        1e-05,
        5e-05,
        0.0001,
        0.0002,
        0.0004
      ],
      "labels": [
        "1e-5",
        "5e-5",
        "1e-4",
        "2e-4",
        "4e-4"
      ],
      "default": 0.0004
    },
    "epochs": {
      "min": 10,
      "max": 500,
      "step": 10,
      "default": 200
    },
    "early_stopping_patience": {
      "min": 5,
      "max": 50,
      "step": 5,
      "default": 10
    },
    "use_resize_conv": {
      "default": true
    },
    "upsampling_mode": {
      "options": [
        "bilinear",
        "nearest",
        "bicubic"
      ],
      "default": "bilinear"
    },
    "masking_strategy": {
      "options": [
        {
          "value": 0,
          "label": "Local Mean"
        },
        {
          "value": 1,
          "label": "Zeros"
        },
        {
          "value": 2,
          "label": "Random"
        },
        {
          "value": 3,
          "label": "UPS 5\u00d75"
        },
        {
          "value": 4,
          "label": "UPS center + struct neighbors"
        }
      ],
      "default": 3
    },
    "bg_side": {
      "options": [
        "light",
        "dark",
        "off"
      ],
      "default": "light",
      "description": "Which intensity side of the images is background: light (dense EM), dark (fluorescence-like), off (flatness-only selection)"
    },
    "rho_floor": {
      "min": 0.0,
      "max": 0.15,
      "step": 0.005,
      "default": 0.05,
      "description": "Effect-size floor: drop mask lags with |correlation| below this (0 disables)"
    },
    "spine_thresh": {
      "min": 4.0,
      "max": 12.0,
      "step": 0.5,
      "default": 8.0,
      "description": "Certainty threshold |z| for significant ACF features"
    },
    "max_pixels": {
      "min": 5,
      "max": 50,
      "step": 1,
      "default": null,
      "description": "Optional cap on the number of masked pixels (empty = no cap)"
    }
  }
}