{
  "presets": {
    "fast": {
      "name": "Fast",
      "description": "Quick training for testing and previewing results. Lower quality but faster iteration.",
      "stage1": {
        "patch_size": 64,
        "patches_per_image": 100,
        "batch_size": 128,
        "mask_percentage": 1.5,
        "mask_center_size": 1,
        "masking_strategy": 3,
        "use_augmentation": true,
        "features": 32,
        "num_layers": 2,
        "activation": "relu",
        "remove_top_skip": true,
        "use_blurpool": true,
        "learning_rate": 0.0004,
        "epochs": 100,
        "early_stopping": true,
        "early_stopping_patience": 10,
        "normalize_method": "zscore",
        "overlap_tile_pad": 16,
        "use_resize_conv": true,
        "upsampling_mode": "bilinear",
        "use_roi": false,
        "stage1_autostruct_overrides": {
          "use_augmentation": false,
          "use_roi": true,
          "roi_threshold": 0.5,
          "scale_factor": 0.25,
          "select_background": true,
          "epochs": 50
        }
      },
      "stage2": {
        "patch_size": 128,
        "patches_per_image": 200,
        "batch_size": 24,
        "mask_percentage": 15.0,
        "masking_strategy": 4,
        "mask_source": "stage1",
        "use_augmentation": false,
        "features": 32,
        "num_layers": 2,
        "activation": "relu",
        "remove_top_skip": true,
        "use_blurpool": true,
        "learning_rate": 0.000075,
        "epochs": 50,
        "early_stopping": true,
        "early_stopping_patience": 10,
        "normalize_method": "zscore",
        "overlap_tile_pad": 16,
        "use_resize_conv": true,
        "upsampling_mode": "bilinear",
        "use_roi": false
      },
      "maskExtractor": {
        "adaptive_thresholding": true,
        "adapt_CB": 50.0,
        "adapt_DF": 0.65,
        "center_size": 15,
        "base_percentile": 50,
        "percentile_decay": 1.035,
        "center_ratio_threshold": 0.2,
        "use_center_proximity": true,
        "center_proximity_threshold": 0.95,
        "keep_center_component_only": true,
        "max_masked_pixels": 25,
        "norm_autocorr": true,
